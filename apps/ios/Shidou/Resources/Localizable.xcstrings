    "Nothing is deleted — the demo holds nothing of yours. You can start it again from the pairing screen.": {
      "comment": "Message in the “Leave the demo?” confirmation dialog.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も削除されません。デモにはあなたのデータはありません。ペアリング画面からいつでも再開できます。"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang natatanggal — walang hawak na sa iyo ang demo. Puwede mo itong simulan ulit sa pairing screen."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "不会删除任何内容——演示中没有你的数据。你可以随时从配对页面重新开始。"
          }
        }
