    "Agent": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェント"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体"
          }
        }
      }
    },
    "Agent preset": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントプリセット"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent preset"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体预设"
          }
        }
      }
    },
    "Agents run on the Mac you paired with. Turning one off hides it from the model picker; it does not uninstall anything.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはペアリングした Mac 上で動きます。オフにするとモデル選択から隠れるだけで、アンインストールはされません。"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa Mac na pinares mo tumatakbo ang mga agent. Ang pag-off ay itinatago lang ito sa model picker; walang ina-uninstall."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体运行在你配对的 Mac 上。关闭只是让它从模型选择中隐藏，并不会卸载任何东西。"
          }
        }
      }
    },
    "All Standard mode capabilities, with tools exposed through the Code Mode SDK so the model can combine multi-step operations in one TypeScript program.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準モードの全機能に加え、Code Mode SDK を通じてツールを提供し、モデルが複数の操作を一つの TypeScript プログラムにまとめられます。"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang lahat ng Standard mode capabilities, na may tools na nakalantad sa Code Mode SDK upang ang model ay makapagsama ng multi-step operations sa isang TypeScript program."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "具备标准模式的全部能力，并通过 Code Mode SDK 提供工具，让模型在一个 TypeScript 程序中组合多步操作。"
          }
        }
      }
    },
    "Allow commands and edits without prompts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認なしでコマンドの実行と編集を許可します"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Payagan ang commands at edits nang walang prompts"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "无需确认即可执行命令和修改文件"
          }
        }
      }
    },
    "Allowed tools": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可されたツール"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga pinapayagang tool"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "允许的工具"
          }
        }
      }
    },
    "An AI reviewer approves routine actions; risky ones still ask": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の操作は AI レビュアーが承認し、リスクのある操作は事前に確認します"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang AI reviewer ay nag-apruba ng routine actions; ang mga mapanganib ay nagtatanong pa rin"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "由 AI 审核并批准常规操作；高风险操作仍会询问"
          }
        }
      }
    },
    "An absolute path on the Mac. Leave it empty to let the daemon find the agent on its own PATH.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 上の絶対パス。空にすると、デーモンが自身の PATH からエージェントを探します。"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolute path sa Mac. Iwanang blangko para hanapin ng daemon ang agent sa sarili nitong PATH."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 上的绝对路径。留空则由守护进程在自己的 PATH 中查找。"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitsura"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "Archive Task": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクをアーカイブ"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "I-archive ang Gawain"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "归档任务"
          }
        }
      }
    },
    "Arguments": {
      "localizations": {
