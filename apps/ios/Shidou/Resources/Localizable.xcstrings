          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "Add a folder from your daemon's computer to start a task in it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デーモンのコンピューターからフォルダを追加して、その中でタスクを始めます。"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Magdagdag ng folder mula sa computer ng daemon para magsimula ng task doon."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "从守护进程所在的电脑添加一个文件夹，然后在其中开始任务。"
          }
        }
      }
    },
    "Add to favorites": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りに追加"
          }
        },
        "tl": {
