            "value": "Arguments"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "参数"
          }
        }
      }
    },
    "Ask Shidou to build something…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shidou に作業を依頼…"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanungin ang Shidou na bumuo ng kahit ano…"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "让 Shidou 构建些什么…"
          }
        }
      }
    },
    "Ask before commands and file changes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドの実行とファイル変更の前に確認します"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Magtanong bago ang commands at file changes"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "执行命令或修改文件前先征求许可"
          }
        }
      }
    },
    "Ask the agent for a `type(scope): subject` first line when it writes a commit message.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミットメッセージの1行目を `type(scope): subject` 形式にするようエージェントに指示します。"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilingin sa agent na gamitin ang `type(scope): subject` sa unang linya ng commit message."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "让智能体在写提交信息时使用 `type(scope): subject` 作为首行。"
          }
        }
      }
    },
    "At least one address is a plain ws:// connection outside your Mac and your tailnet. Anyone on that network can read the token.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少なくとも1つのアドレスが、Mac と tailnet の外に出る平文の ws:// 接続です。そのネットワーク上の誰でもトークンを読み取れます。"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "May kahit isang address na plain ws:// sa labas ng Mac mo at ng tailnet mo. Mababasa ng kahit sino sa network na iyon ang token."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "至少有一个地址是明文 ws:// 连接，位于你的 Mac 和 tailnet 之外。该网络上的任何人都能读到令牌。"
          }
        }
      }
    },
