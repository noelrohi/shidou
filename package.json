{
  "name": "shidou-workspace",
  "type": "module",
  "scripts": {
    "dev": "bun ./scripts/dev.ts",
    "release": "bun ./scripts/release.ts",
    "ios-release": "bun ./scripts/ios-release.ts",
    "bump": "bun ./scripts/bump.ts",
    "licenses:generate": "bun ./scripts/licenses.ts",
    "licenses:check": "bun ./scripts/licenses.ts --check",
    "protocol:generate": "cargo run -p shidou-protocol --bin export_types",
    "protocol:check": "cargo run -p shidou-protocol --bin export_types -- --check",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "private": true,
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "license-checker-rseidelsohn": "4.4.2",
    "typescript": "^7.0.2"
  },
  "workspaces": ["website", "apps/*", "packages/*"],
  "dependencies": {
    "pngjs": "^7.0.0"
  }
}
